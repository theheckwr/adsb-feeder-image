# Open Glider Network receiver configuration (rtlsdr-ogn).
#
# This file is generated by the ADS-B Feeder Image setup app from your station
# settings and the OGN options you choose in the web UI.
#
# Anything of the form %env-name% is a magic value that the UI will replace.
# If you change any of these, please don't be surprised if things break and the
# UI appears to malfunction.
#
# Updates to the ADS-B Feeder Image will likely overwrite any edits that you
# make in this file. If you prefer to manually edit this file, that's ok. In
# that case please set the following entry to 1 (yes, this is commented out, it's
# parsed by the UI app, not the OGN container):
#
# %LOCAL_EDITS_DONT_MANAGE%=0
#
# Setting this to 0 means that the UI will manage the file, setting it to 1 means
# you are doing this yourself.

# Station position (degrees / metres AMSL) - taken from the global station setup
STATION_LAT=%lat%
STATION_LON=%lon%
STATION_ALT_MSL_M=%alt%

# APRS callsign for this receiver, max. 9 characters, see
# http://wiki.glidernet.org/receiver-naming-convention
STATION_NAME=%ogn_station_name%

# Optional beacon comment fields
STATION_COMMENT_ANTENNA=%ogn_comment_antenna%
STATION_COMMENT_FILTER=%ogn_comment_filter%
STATION_COMMENT_AMPLIFIER=%ogn_comment_amplifier%
STATION_COMMENT_DONGLE=%ogn_comment_dongle%
STATION_COMMENT_CLUB=%ogn_comment_club%
STATION_COMMENT_EMAIL=%ogn_comment_email%
STATION_COMMENT_WEBSITE=%ogn_comment_website%
STATION_COMMENT_NOTE=%ogn_comment_note%

# Frequency plan: 0=automatic, 1=EU/Africa, 2=USA/Canada, 3=South America/Australia,
# 4=New Zealand, 5=Israel, 6=EU/Africa 433MHz, 7=Japan
FREQ_PLAN=%ogn_freq_plan%

# Nearest GSM900 base-station centre frequency [MHz] used for PPM auto-calibration
# (0 disables GSM based calibration)
GSM_CENTER_FREQ=%ogn_gsm_center_freq%

# The RTL-SDR used for 868 MHz OGN reception
SDR_868_SERIAL=%ognserial%
SDR_868_PPM=%ogn_device_ppm%
SDR_868_BIAS_T_ENABLE=%ognbiastee%

# Optional Time-of-Arrival / merge server targets (leave empty to disable)
TOA_SERVER=%ogn_toa_server%
MERGE_SERVER=%ogn_merge_server%

# Feed your locally received 1090 MHz ADS-B traffic into the Open Glider Network.
# ADSB_AVR is the address of the readsb raw/AVR output (empty = disabled).
# ADSB_MAX_ALT_FT is the maximum altitude in feet above which ADS-B traffic is not shared.
ADSB_AVR=%ogn_adsb_avr%
ADSB_MAX_ALT_FT=%ogn_adsb_max_alt_ft%
